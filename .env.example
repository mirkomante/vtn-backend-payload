# =============================================================================
# Variabili d'ambiente per VTN Backend Payload
# =============================================================================
# Copia questo file in .env e modifica i valori
# cp .env.example .env

# -----------------------------------------------------------------------------
# Database - PostgreSQL (OBBLIGATORIO)
# -----------------------------------------------------------------------------
# Locale: connessione diretta
DATABASE_URL=postgresql://postgres:password@localhost:5432/vtn-backend-payloadcms

# Produzione Cloud Run: usa Unix socket
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/vtn-backend-payloadcms?host=/cloudsql/PROJECT:REGION:INSTANCE

# -----------------------------------------------------------------------------
# Payload CMS (OBBLIGATORIO)
# -----------------------------------------------------------------------------
# Chiave segreta per firmare token JWT - minimo 32 caratteri
# Genera con: openssl rand -base64 32
PAYLOAD_SECRET=your-secret-key-min-32-chars

# URL pubblico del server (per OAuth redirect e link assoluti)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (OPZIONALE in locale se non testi OAuth)
# -----------------------------------------------------------------------------
# Credenziali OAuth 2.0 da Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Google Cloud Storage (OPZIONALE - solo in produzione)
# -----------------------------------------------------------------------------
# Se NON impostato: i media vengono salvati nella cartella locale /media
# Se impostato: i media vengono caricati su Google Cloud Storage
#
# ARCHITETTURA MULTI-BUCKET:
#   GCS_BUCKET      → collection `media`            (media generici del sito)
#   GCS_MENU_BUCKET → collection `media-ristorante` (logo, icone menu ristorante)
#                   → anche il bucket dove viene scritto disponibilita.json
#                     dal Smart Webhook (via FRONTEND_TARGETS in smartWebhook.ts)
#
# I due plugin gcsStorage sono configurati separatamente in payload.config.ts.
# Ogni collection usa la propria variabile in adminThumbnail e hook afterRead.

# Bucket GCS per la collection `media` (media generici)
# GCS_BUCKET=vtn25-media

# ID del progetto GCP (condiviso da entrambi i plugin)
# GCP_PROJECT_ID=vtn25-475411

# Bucket GCS per la collection `media-ristorante` + disponibilita.json frontend
# Sostituisce GCS_FRONTEND_BUCKET (deprecato)
# GCS_MENU_BUCKET=vtn25-menu-frontend

# Futuri target frontend (aggiungere quando necessario):
# GCS_CORPORATE_BUCKET=vtn25-corporate-frontend
# GCS_SHOP_BUCKET=vtn25-shop-frontend

# -----------------------------------------------------------------------------
# Google Cloud Pub/Sub (OPZIONALE - solo in produzione)
# -----------------------------------------------------------------------------
# Topic Pub/Sub per rebuild menu (hardcoded: 'rebuild-menu')
# Richiede GCP_PROJECT_ID configurato sopra

# =============================================================================
# Variabili d'ambiente per VTN Backend Payload
# =============================================================================
# Copia questo file in .env e modifica i valori
# cp .env.example .env

# -----------------------------------------------------------------------------
# Database - PostgreSQL (OBBLIGATORIO)
# -----------------------------------------------------------------------------
# Locale: connessione diretta
DATABASE_URL=postgresql://postgres:password@localhost:5432/vtn-backend-payloadcms

# Produzione Cloud Run: usa Unix socket
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/vtn-backend-payloadcms?host=/cloudsql/PROJECT:REGION:INSTANCE

# -----------------------------------------------------------------------------
# Payload CMS (OBBLIGATORIO)
# -----------------------------------------------------------------------------
# Chiave segreta per firmare token JWT - minimo 32 caratteri
# Genera con: openssl rand -base64 32
PAYLOAD_SECRET=your-secret-key-min-32-chars

# URL pubblico del server (per OAuth redirect e link assoluti)
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Google OAuth (OPZIONALE in locale se non testi OAuth)
# -----------------------------------------------------------------------------
# Credenziali OAuth 2.0 da Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# -----------------------------------------------------------------------------
# Google Cloud Storage (OPZIONALE - solo in produzione)
# -----------------------------------------------------------------------------
# Se NON impostato: i media vengono salvati nella cartella locale /media
# Se impostato: i media vengono caricati su Google Cloud Storage

# Nome del bucket GCS (deve esistere e avere i permessi corretti)
# GCS_BUCKET=vtn25-media

# ID del progetto GCP
# GCP_PROJECT_ID=vtn25-475411
